{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug LibraryAPI",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/LibraryAPI/bin/Debug/net10.0/LibraryAPI.exe",
            "cwd": "${workspaceFolder}/LibraryAPI",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5278"
            },
            "preLaunchTask": "build LibraryAPI"
        }
    ]
}
